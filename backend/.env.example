# Template only. scripts/create_local_config.py generates local credentials.
DB_NAME=aura
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_database_password
DB_HOST=127.0.0.1
# Docker judge setup uses 5433; native PostgreSQL commonly uses 5432.
DB_PORT=5433
AUTH_JWT_SECRET=replace_with_a_random_secret
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
# Required for original-image chat and visual video interpretation.
# Run scripts/setup_multimodal.ps1 on EACH backend laptop to install/configure it.
OLLAMA_VISION_MODEL=gemma3:4b
AURA_OCR_ENABLED=true
WHISPER_MODEL_SIZE=small.en
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional for legacy .ppt if LibreOffice is not detected automatically:
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
NEBIUS_API_KEY=replace_with_your_nebius_api_key
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

NEBIUS_MAX_TOKENS=4096
NEBIUS_JSON_MAX_TOKENS=4096
NEBIUS_READ_TIMEOUT=120
# Long summaries on Nemotron 3 Super default to none to reserve tokens for writing.
# Blank uses the model-specific default; provider preserves provider reasoning defaults.
NEBIUS_SUMMARY_REASONING_EFFORT=
# Small citation/intent judges: auto = none for the tested Nemotron Super ID.
# Set provider to opt out. A truncated check gets at most one bounded retry.
NEBIUS_VERIFICATION_REASONING_EFFORT=

# Optional routing candidates. Leave blank to use the tested NEBIUS_MODEL.
# Populate exact model IDs only after comparing them on evaluation/coverage_cases.json.
NEBIUS_COVERAGE_MODEL=
NEBIUS_ANSWER_MODEL=
NEBIUS_DEEP_MODEL=

# Optional quality profile: python scripts/configure_model_quality.py --apply --smoke
# The command selects the documented Nemotron Ultra model, keeps credentials and
# raises writing allowances. --smoke spends one small synthetic model request.
# Additional background is always separately labelled and never receives slide citations.
# Explicit "use only my material" requests disable it.
AURA_SUMMARY_BACKGROUND=false
AURA_SUMMARY_EXPANSION_SECONDS=180
AURA_SUMMARY_REPAIRS=2

# Optional: enables Tavily web search for Research runs. Never expose this in Vite.
TAVILY_API_KEY=

# Python agent: disabled until an isolation backend is explicitly configured.
# docker = local prepared Linux container; nebius = Token Factory Sandboxes VM.
AURA_CODE_BACKEND=disabled
AURA_DOCKER_IMAGE=aura-code:1
# Optional exact CLI path. Windows defaults to docker.exe, never a shell shim.
AURA_DOCKER_EXECUTABLE=
# Nebius Sandboxes requires project access and an immutable Python image UUID.
# Reuses NEBIUS_API_KEY above; never pass API keys into the guest.
NEBIUS_PROJECT_ID=
NEBIUS_SANDBOX_IMAGE=

# Prototype: usage is recorded but daily blocking limits are disabled.
# Set true to enforce the configured user/global/study daily token ceilings.
AURA_DAILY_LIMITS_ENABLED=false
# Study workspace v2: per-request sizes and optional daily allowances.
MAX_QUESTIONS_PER_REQUEST=50
MAX_FLASHCARDS_PER_REQUEST=100
STUDY_DAILY_TOKEN_BUDGET=1000000
STUDY_DEDUP_COSINE_THRESHOLD=0.93
