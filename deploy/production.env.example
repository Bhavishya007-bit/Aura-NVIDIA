# Copy outside Git. Never paste real secrets into GitHub or VITE_ variables.
AURA_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@MANAGED_HOST:5432/aura?sslmode=require
AUTH_JWT_SECRET=replace_with_at_least_32_random_bytes
NEBIUS_API_KEY=replace_with_your_token_factory_key
NEBIUS_BASE_URL=https://api.tokenfactory.us-central1.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
NEBIUS_COVERAGE_MODEL=
NEBIUS_ANSWER_MODEL=
NEBIUS_DEEP_MODEL=
NEBIUS_SUMMARY_REASONING_EFFORT=none
NEBIUS_VERIFICATION_REASONING_EFFORT=none
AURA_PUBLIC_HOSTNAME=replace_with_public_hostname
AURA_ALLOWED_HOSTS=localhost,127.0.0.1,replace_with_public_hostname
AURA_CORS_ORIGINS=
AURA_USER_DAILY_TOKENS=500000
AURA_GLOBAL_DAILY_TOKENS=2000000
AURA_REQUESTS_PER_MINUTE=240
AURA_LOGIN_PER_MINUTE=20
AURA_AI_ENABLED=true
AURA_ALLOW_REGISTRATION=false
AURA_DEMO_ENABLED=true
AURA_DEMO_EMAIL=judge@aura.example.org
AURA_DEMO_PASSWORD=replace_with_a_random_password_at_least_16_characters
STUDY_DAILY_TOKEN_BUDGET=1000000
AURA_CODE_BACKEND=disabled
# An existing remote Ollama vision host, or the optional service in production compose.
OLLAMA_BASE_URL=http://vision:11434
OLLAMA_VISION_MODEL=gemma3:4b
AURA_EMBEDDING_DEVICE=cpu
AURA_OCR_ENABLED=true
WHISPER_MODEL_SIZE=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TAVILY_API_KEY=
