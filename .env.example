# Vite uses this value in the browser. Point it at the FastAPI service.
VITE_API_BASE_URL=http://127.0.0.1:8000

# FastAPI reads these values from its process environment (not from this file).
FIELDNOTE_STORAGE_DIR=backend/.local_storage
FIELDNOTE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,https://i-am-building-a-web-application.vercel.app
